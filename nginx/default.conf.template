server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    # SDUI screens -> web-gateway. WEB_GATEWAY_URL must not contain a path.
    location /ui/sdui/ {
        proxy_pass ${WEB_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Actions -> web-gateway (kept separate from screen fetching).
    location /action/ {
        proxy_pass ${WEB_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: serve built assets directly, everything else -> index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
