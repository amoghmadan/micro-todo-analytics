[submodule "gateways/api-gateway"]
	path = gateways/api-gateway
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = gateway/api
[submodule "gateways/web-gateway"]
	path = gateways/web-gateway
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = gateway/web
[submodule "services/auth-service"]
	path = services/auth-service
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = service/auth
[submodule "services/task-service"]
	path = services/task-service
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = service/task
[submodule "services/tracker-service"]
	path = services/tracker-service
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = service/tracker
[submodule "uis/web-ui"]
	path = uis/web-ui
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = ui/web
[submodule "deploy"]
	path = deploy
	url = https://github.com/amoghmadan/micro-todo-analytics.git
	branch = deploy
